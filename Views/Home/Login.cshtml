@{
    ViewData["Title"] = "تسجيل الدخول";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;" dir="rtl">
    <div class="card shadow-lg border-0 rounded-4 p-5" style="width: 100%; max-width: 450px;">
        <div class="text-center mb-4">
            <h2 class="fw-bold text-dark">تسجيل الدخول</h2>
            <p class="text-muted small">أدخل بريدك الإلكتروني وكلمة السر للوصول للنظام</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success rounded-3 text-center">@TempData["SuccessMessage"]</div>
        }

        <form method="post">
            <div asp-validation-summary="All" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label class="form-label fw-semibold">البريد الإلكتروني:</label>
                <input type="email" name="email" class="form-control rounded-3 py-2" required placeholder="name@example.com" />
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">كلمة السر:</label>
                <input type="password" name="password" class="form-control rounded-3 py-2" required placeholder="••••••••" />
            </div>

            <div class="d-grid mb-3">
                <button type="submit" class="btn btn-primary py-2 fw-bold rounded-3 shadow-sm">تسجيل الدخول</button>
            </div>

            <div class="text-center mt-3">
                <p class="text-muted small">ليس لديك حساب؟ <a href="/Home/Register" class="text-decoration-none fw-bold text-primary">إنشاء حساب جديد</a></p>
            </div>
        </form>
    </div>
</div>
