@{
    ViewData["Title"] = "لوحة التحكم - فعاليات الشارقة";
    var bookFairs = ViewBag.BookFairs as List<SharjahEventsWeb.Models.SharjahBookFair> ?? new List<SharjahEventsWeb.Models.SharjahBookFair>();
    var childFestivals = ViewBag.ChildFestivals as List<SharjahEventsWeb.Models.SharjahChildFestival> ?? new List<SharjahEventsWeb.Models.SharjahChildFestival>();
    var distributors = ViewBag.Distributors as List<SharjahEventsWeb.Models.DistributorsConference> ?? new List<SharjahEventsWeb.Models.DistributorsConference>();
    var newYork = ViewBag.NewYork as List<SharjahEventsWeb.Models.NewYorkSession> ?? new List<SharjahEventsWeb.Models.NewYorkSession>();
    var publishersConf = ViewBag.PublishersConf as List<SharjahEventsWeb.Models.PublishersConference> ?? new List<SharjahEventsWeb.Models.PublishersConference>();
    var publishersWorkshops = ViewBag.PublishersWorkshops as List<SharjahEventsWeb.Models.PublishersWorkshop> ?? new List<SharjahEventsWeb.Models.PublishersWorkshop>();
    var distributorsWorkshops = ViewBag.DistributorsWorkshops as List<SharjahEventsWeb.Models.DistributorsWorkshop> ?? new List<SharjahEventsWeb.Models.DistributorsWorkshop>();

    string searchQuery = ViewBag.SearchQuery as string ?? "";
    string activeTab = ViewBag.ActiveTab as string ?? "SharjahBookFairs";
}

<style>
    .tab-bookfair { background-color: #0d6efd !important; color: white !important; }
    .tab-child { background-color: #198754 !important; color: white !important; }
    .tab-distributors { background-color: #ffc107 !important; color: #000 !important; }
    .tab-newyork { background-color: #6f42c1 !important; color: white !important; }
    .tab-publishers { background-color: #fd7e14 !important; color: white !important; }
    .tab-pworkshop { background-color: #0dcaf0 !important; color: #000 !important; }
    .tab-dworkshop { background-color: #20c997 !important; color: white !important; }

    .nav-pills .nav-link {
        border-radius: 50rem !important;
        margin-left: 5px;
        font-weight: bold;
        transition: all 0.3s ease;
        margin-bottom: 5px;
    }
</style>

<div class="container-fluid py-4 px-4" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-4 rounded-4 shadow-sm">
        <div>
            <h2 class="fw-bold text-dark mb-1">لوحة إدارة فعاليات الشارقة الثقافية</h2>
            <p class="text-muted mb-0">إدارة دور النشر والفعاليات وورش العمل وتصدير التقارير.</p>
        </div>
        <div>
            <a href="/Home/Logout" class="btn btn-outline-danger px-4 rounded-pill fw-semibold">تسجيل الخروج 🚪</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- شريط البحث -->
    <div class="card shadow-sm border-0 rounded-4 p-4 mb-4 bg-white">
        <form method="get" action="/Home/Index" class="row g-3 align-items-center">
            <input type="hidden" name="activeTab" value="@activeTab" />
            <div class="col-md-10">
                <input type="text" name="searchQuery" value="@searchQuery" class="form-control form-control-lg rounded-3" placeholder="ابحث باسم الجهة، المحاضر، الدولة..." />
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-dark btn-lg rounded-3 fw-bold">بحث 🔍</button>
            </div>
        </form>
    </div>

    <!-- التبويبات -->
    <ul class="nav nav-pills mb-3 gap-2 flex-wrap" id="eventTabs" role="tablist">
        <li class="nav-item"><button class="nav-link tab-bookfair @(activeTab == "SharjahBookFairs" ? "active" : "") shadow-sm px-4 py-2" data-bs-toggle="pill" data-bs-target="#bookfair" type="button">📘 معرض الكتاب</button></li>
        <li class="nav-item"><button class="nav-link tab-child @(activeTab == "SharjahChildFestivals" ? "active" : "") shadow-sm px-4 py-2" data-bs-toggle="pill" data-bs-target="#child" type="button">🎈 مهرجان الطفل</button></li>
        <li class="nav-item"><button class="nav-link tab-distributors @(activeTab == "DistributorsConferences" ? "active" : "") shadow-sm px-4 py-2" data-bs-toggle="pill" data-bs-target="#distributors" type="button">🤝 مؤتمر الموزعين</button></li>
        <li class="nav-item"><button class="nav-link tab-newyork @(activeTab == "NewYorkSessions" ? "active" : "") shadow-sm px-4 py-2" data-bs-toggle="pill" data-bs-target="#newyork" type="button">🗽 دورة نيويورك</button></li>
        <li class="nav-item"><button class="nav-link tab-publishers @(activeTab == "PublishersConferences" ? "active" : "") shadow-sm px-4 py-2" data-bs-toggle="pill" data-bs-target="#publishers" type="button">🏢 مؤتمر الناشرين</button></li>
        <li class="nav-item"><button class="nav-link tab-pworkshop @(activeTab == "PublishersWorkshops" ? "active" : "") shadow-sm px-4 py-2" data-bs-toggle="pill" data-bs-target="#pworkshop" type="button">👨‍🏫 ورش الناشرين</button></li>
        <li class="nav-item"><button class="nav-link tab-dworkshop @(activeTab == "DistributorsWorkshops" ? "active" : "") shadow-sm px-4 py-2" data-bs-toggle="pill" data-bs-target="#dworkshop" type="button">🧑‍🏫 ورش الموزعين</button></li>
    </ul>

    <div class="tab-content bg-white p-4 rounded-4 shadow-sm">
        
        <!-- 1. معرض الكتاب -->
        <div class="tab-pane fade @(activeTab == "SharjahBookFairs" ? "show active" : "")" id="bookfair" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold text-primary">📘 معرض الشارقة الدولي للكتاب</h4>
                <div>
                    <a href="/Home/AddRecord?section=SharjahBookFairs" class="btn btn-primary rounded-pill px-3 fw-bold">＋ إضافة</a>
                    <a href="/Home/ExportExcel?section=SharjahBookFairs" class="btn btn-success rounded-pill px-3 fw-bold">📊 تصدير إكسل</a>
                    <form action="/Home/DeleteAll" method="post" class="d-inline" onsubmit="return confirm('⚠️ حذف الكل؟');">
                        <input type="hidden" name="section" value="SharjahBookFairs" />
                        <button type="submit" class="btn btn-outline-danger rounded-pill px-3 fw-bold">🗑️ حذف الكل</button>
                    </form>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-primary">
                        <tr><th>السنة</th><th>دار النشر</th><th>الدولة / المدينة</th><th>واتساب</th><th>الإيميل</th><th>المسؤول</th><th>الإصدارات</th><th>التخصص</th><th>المساحة</th><th>الإجراءات</th></tr>
                    </thead>
                    <tbody>
                        @if (bookFairs != null) {
                            @foreach (var item in bookFairs) {
                                <tr>
                                    <td>@item.ExhibitionYear</td>
                                    <td class="fw-bold">@item.PublishingHouseName</td>
                                    <td>@item.Country / @item.City</td>
                                    <td>@item.WhatsAppNumber</td>
                                    <td>@item.Email</td>
                                    <td>@item.ResponsiblePerson</td>
                                    <td>@item.BookCount</td>
                                    <td>@item.Specialization</td>
                                    <td>@item.RequiredSpace</td>
                                    <td>
                                        <a href="/Home/Edit?section=SharjahBookFairs&id=@item.Id" class="btn btn-sm btn-warning rounded-pill px-3 mb-1">تعديل ✏️</a>
                                        <form action="/Home/Delete" method="post" class="d-inline" onsubmit="return confirm('حذف هذا السجل؟');">
                                            <input type="hidden" name="section" value="SharjahBookFairs" />
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-danger rounded-pill px-3">حذف 🗑️️</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- 2. مهرجان الطفل -->
        <div class="tab-pane fade @(activeTab == "SharjahChildFestivals" ? "show active" : "")" id="child" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold text-success">🎈 مهرجان الشارقة القرائي للطفل</h4>
                <div>
                    <a href="/Home/AddRecord?section=SharjahChildFestivals" class="btn btn-success rounded-pill px-3 fw-bold">＋ إضافة</a>
                    <a href="/Home/ExportExcel?section=SharjahChildFestivals" class="btn btn-success rounded-pill px-3 fw-bold">📊 تصدير إكسل</a>
                    <form action="/Home/DeleteAll" method="post" class="d-inline" onsubmit="return confirm('⚠️ حذف الكل؟');">
                        <input type="hidden" name="section" value="SharjahChildFestivals" />
                        <button type="submit" class="btn btn-outline-danger rounded-pill px-3 fw-bold">🗑️ حذف الكل</button>
                    </form>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-success">
                        <tr><th>السنة</th><th>دار النشر</th><th>الدولة / المدينة</th><th>واتساب</th><th>الإيميل</th><th>المسؤول</th><th>الإصدارات</th><th>المساحة</th><th>الإجراءات</th></tr>
                    </thead>
                    <tbody>
                        @if (childFestivals != null) {
                            @foreach (var item in childFestivals) {
                                <tr>
                                    <td>@item.FestivalYear</td>
                                    <td class="fw-bold">@item.PublishingHouseName</td>
                                    <td>@item.Country / @item.City</td>
                                    <td>@item.WhatsAppNumber</td>
                                    <td>@item.Email</td>
                                    <td>@item.ResponsiblePerson</td>
                                    <td>@item.BookCount</td>
                                    <td>@item.RequiredSpace</td>
                                    <td>
                                        <a href="/Home/Edit?section=SharjahChildFestivals&id=@item.Id" class="btn btn-sm btn-warning rounded-pill px-3 mb-1">تعديل ✏️</a>
                                        <form action="/Home/Delete" method="post" class="d-inline" onsubmit="return confirm('حذف هذا السجل؟');">
                                            <input type="hidden" name="section" value="SharjahChildFestivals" />
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-danger rounded-pill px-3">حذف 🗑️</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- 3. مؤتمر الموزعين -->
        <div class="tab-pane fade @(activeTab == "DistributorsConferences" ? "show active" : "")" id="distributors" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold text-warning">🤝 مؤتمر الموزعين</h4>
                <div>
                    <a href="/Home/AddRecord?section=DistributorsConferences" class="btn btn-warning rounded-pill px-3 fw-bold text-dark">＋ إضافة</a>
                    <a href="/Home/ExportExcel?section=DistributorsConferences" class="btn btn-success rounded-pill px-3 fw-bold">📊 تصدير إكسل</a>
                    <form action="/Home/DeleteAll" method="post" class="d-inline" onsubmit="return confirm('⚠️ حذف الكل؟');">
                        <input type="hidden" name="section" value="DistributorsConferences" />
                        <button type="submit" class="btn btn-outline-danger rounded-pill px-3 fw-bold">🗑️ حذف الكل</button>
                    </form>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-warning">
                        <tr><th>السنة</th><th>دار النشر</th><th>الدولة / المدينة</th><th>واتساب</th><th>الإيميل</th><th>المسؤول</th><th>الإجراءات</th></tr>
                    </thead>
                    <tbody>
                        @if (distributors != null) {
                            @foreach (var item in distributors) {
                                <tr>
                                    <td>@item.ConferenceYear</td>
                                    <td class="fw-bold">@item.PublishingHouseName</td>
                                    <td>@item.Country / @item.City</td>
                                    <td>@item.WhatsAppNumber</td>
                                    <td>@item.Email</td>
                                    <td>@item.ResponsiblePerson</td>
                                    <td>
                                        <a href="/Home/Edit?section=DistributorsConferences&id=@item.Id" class="btn btn-sm btn-warning rounded-pill px-3 mb-1">تعديل ✏️</a>
                                        <form action="/Home/Delete" method="post" class="d-inline" onsubmit="return confirm('حذف هذا السجل؟');">
                                            <input type="hidden" name="section" value="DistributorsConferences" />
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-danger rounded-pill px-3">حذف 🗑️️</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- 4. دورة نيويورك -->
        <div class="tab-pane fade @(activeTab == "NewYorkSessions" ? "show active" : "")" id="newyork" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold" style="color: #6f42c1;">🗽 دورة نيويورك</h4>
                <div>
                    <a href="/Home/AddRecord?section=NewYorkSessions" class="btn rounded-pill px-3 fw-bold text-white" style="background-color: #6f42c1;">＋ إضافة</a>
                    <a href="/Home/ExportExcel?section=NewYorkSessions" class="btn btn-success rounded-pill px-3 fw-bold">📊 تصدير إكسل</a>
                    <form action="/Home/DeleteAll" method="post" class="d-inline" onsubmit="return confirm('⚠️ حذف الكل؟');">
                        <input type="hidden" name="section" value="NewYorkSessions" />
                        <button type="submit" class="btn btn-outline-danger rounded-pill px-3 fw-bold">🗑️ حذف الكل</button>
                    </form>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead style="background-color: #e2d9f3;">
                        <tr><th>السنة</th><th>دار النشر</th><th>الدولة / المدينة</th><th>واتساب</th><th>الإيميل</th><th>المسؤول</th><th>الإجراءات</th></tr>
                    </thead>
                    <tbody>
                        @if (newYork != null) {
                            @foreach (var item in newYork) {
                                <tr>
                                    <td>@item.SessionYear</td>
                                    <td class="fw-bold">@item.PublishingHouseName</td>
                                    <td>@item.Country / @item.City</td>
                                    <td>@item.WhatsAppNumber</td>
                                    <td>@item.Email</td>
                                    <td>@item.ResponsiblePerson</td>
                                    <td>
                                        <a href="/Home/Edit?section=NewYorkSessions&id=@item.Id" class="btn btn-sm btn-warning rounded-pill px-3 mb-1">تعديل ✏️</a>
                                        <form action="/Home/Delete" method="post" class="d-inline" onsubmit="return confirm('حذف هذا السجل؟');">
                                            <input type="hidden" name="section" value="NewYorkSessions" />
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-danger rounded-pill px-3">حذف 🗑️</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- 5. مؤتمر الناشرين -->
        <div class="tab-pane fade @(activeTab == "PublishersConferences" ? "show active" : "")" id="publishers" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold" style="color: #fd7e14;">🏢 مؤتمر الناشرين</h4>
                <div>
                    <a href="/Home/AddRecord?section=PublishersConferences" class="btn rounded-pill px-3 fw-bold text-white" style="background-color: #fd7e14;">＋ إضافة</a>
                    <a href="/Home/ExportExcel?section=PublishersConferences" class="btn btn-success rounded-pill px-3 fw-bold">📊 تصدير إكسل</a>
                    <form action="/Home/DeleteAll" method="post" class="d-inline" onsubmit="return confirm('⚠️ حذف الكل؟');">
                        <input type="hidden" name="section" value="PublishersConferences" />
                        <button type="submit" class="btn btn-outline-danger rounded-pill px-3 fw-bold">🗑️ حذف الكل</button>
                    </form>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead style="background-color: #ffe8d6;">
                        <tr><th>السنة</th><th>دار النشر</th><th>الدولة / المدينة</th><th>واتساب</th><th>الإيميل</th><th>المسؤول</th><th>الإجراءات</th></tr>
                    </thead>
                    <tbody>
                        @if (publishersConf != null) {
                            @foreach (var item in publishersConf) {
                                <tr>
                                    <td>@item.ConferenceYear</td>
                                    <td class="fw-bold">@item.PublishingHouseName</td>
                                    <td>@item.Country / @item.City</td>
                                    <td>@item.WhatsAppNumber</td>
                                    <td>@item.Email</td>
                                    <td>@item.ResponsiblePerson</td>
                                    <td>
                                        <a href="/Home/Edit?section=PublishersConferences&id=@item.Id" class="btn btn-sm btn-warning rounded-pill px-3 mb-1">تعديل ✏️</a>
                                        <form action="/Home/Delete" method="post" class="d-inline" onsubmit="return confirm('حذف هذا السجل؟');">
                                            <input type="hidden" name="section" value="PublishersConferences" />
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-danger rounded-pill px-3">حذف 🗑️</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- 6. ورش عمل مؤتمر الناشرين -->
        <div class="tab-pane fade @(activeTab == "PublishersWorkshops" ? "show active" : "")" id="pworkshop" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold text-info">👨‍🏫 ورش عمل مؤتمر الناشرين</h4>
                <div>
                    <a href="/Home/AddRecord?section=PublishersWorkshops" class="btn btn-info rounded-pill px-3 fw-bold text-dark">＋ إضافة</a>
                    <a href="/Home/ExportExcel?section=PublishersWorkshops" class="btn btn-success rounded-pill px-3 fw-bold">📊 تصدير إكسل</a>
                    <form action="/Home/DeleteAll" method="post" class="d-inline" onsubmit="return confirm('⚠️ حذف الكل؟');">
                        <input type="hidden" name="section" value="PublishersWorkshops" />
                        <button type="submit" class="btn btn-outline-danger rounded-pill px-3 fw-bold">🗑️ حذف الكل</button>
                    </form>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-info">
                        <tr><th>السنة</th><th>اسم المحاضر</th><th>الدولة</th><th>واتساب</th><th>الإيميل</th><th>الحالة</th><th>الإجراءات</th></tr>
                    </thead>
                    <tbody>
                        @if (publishersWorkshops != null) {
                            @foreach (var item in publishersWorkshops) {
                                <tr>
                                    <td>@item.WorkshopYear</td>
                                    <td class="fw-bold">@item.LecturerName</td>
                                    <td>@item.Country</td>
                                    <td>@item.WhatsAppNumber</td>
                                    <td>@item.Email</td>
                                    <td>
                                        <form action="/Home/ToggleComplete" method="post" class="d-inline">
                                            <input type="hidden" name="section" value="PublishersWorkshops" />
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm @(item.IsCompleted ? "btn-success" : "btn-outline-secondary") rounded-pill px-3 fw-bold">
                                                @(item.IsCompleted ? "✓ مكتمل" : "⏳ قيد العمل")
                                            </button>
                                        </form>
                                    </td>
                                    <td>
                                        <a href="/Home/Edit?section=PublishersWorkshops&id=@item.Id" class="btn btn-sm btn-warning rounded-pill px-3 mb-1">تعديل ✏️</a>
                                        <form action="/Home/Delete" method="post" class="d-inline" onsubmit="return confirm('حذف هذا السجل؟');">
                                            <input type="hidden" name="section" value="PublishersWorkshops" />
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-danger rounded-pill px-3">حذف 🗑️</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- 7. ورش عمل مؤتمر الموزعين -->
        <div class="tab-pane fade @(activeTab == "DistributorsWorkshops" ? "show active" : "")" id="dworkshop" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold" style="color: #20c997 !important;">🧑‍🏫 ورش عمل مؤتمر الموزعين</h4>
                <div>
                    <a href="/Home/AddRecord?section=DistributorsWorkshops" class="btn btn-success rounded-pill px-3 fw-bold" style="background-color: #20c997; border-color: #20c997;">＋ إضافة</a>
                    <a href="/Home/ExportExcel?section=DistributorsWorkshops" class="btn btn-success rounded-pill px-3 fw-bold">📊 تصدير إكسل</a>
                    <form action="/Home/DeleteAll" method="post" class="d-inline" onsubmit="return confirm('⚠️ حذف الكل؟');">
                        <input type="hidden" name="section" value="DistributorsWorkshops" />
                        <button type="submit" class="btn btn-outline-danger rounded-pill px-3 fw-bold">🗑️️ حذف الكل</button>
                    </form>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead style="background-color: #20c997; color: white;">
                        <tr><th>السنة</th><th>اسم المحاضر</th><th>الدولة</th><th>واتساب</th><th>الإيميل</th><th>الحالة</th><th>الإجراءات</th></tr>
                    </thead>
                    <tbody>
                        @if (distributorsWorkshops != null) {
                            @foreach (var item in distributorsWorkshops) {
                                <tr>
                                    <td>@item.WorkshopYear</td>
                                    <td class="fw-bold">@item.LecturerName</td>
                                    <td>@item.Country</td>
                                    <td>@item.WhatsAppNumber</td>
                                    <td>@item.Email</td>
                                    <td>
                                        <form action="/Home/ToggleComplete" method="post" class="d-inline">
                                            <input type="hidden" name="section" value="DistributorsWorkshops" />
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm @(item.IsCompleted ? "btn-success" : "btn-outline-secondary") rounded-pill px-3 fw-bold">
                                                @(item.IsCompleted ? "✓ مكتمل" : "⏳ قيد العمل")
                                            </button>
                                        </form>
                                    </td>
                                    <td>
                                        <a href="/Home/Edit?section=DistributorsWorkshops&id=@item.Id" class="btn btn-sm btn-warning rounded-pill px-3 mb-1">تعديل ✏️</a>
                                        <form action="/Home/Delete" method="post" class="d-inline" onsubmit="return confirm('حذف هذا السجل؟');">
                                            <input type="hidden" name="section" value="DistributorsWorkshops" />
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-danger rounded-pill px-3">حذف 🗑️</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>