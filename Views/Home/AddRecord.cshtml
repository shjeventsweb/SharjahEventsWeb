@{
    ViewData["Title"] = "إضافة بيانات جديدة";
    string secName = ViewBag.Section;
}

<div class="container mt-5" dir="rtl" style="max-width: 700px;">
    <div class="card shadow p-4">
        <h2 class="text-center mb-4 text-primary">إضافة سجل جديد</h2>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }

        <form method="post">
            <input type="hidden" name="section" value="@secName" />

            <div class="mb-3">
                <label class="form-label">السنة:</label>
                <input type="number" name="year" class="form-control" required value="2026" />
            </div>

            <div class="mb-3">
                <label class="form-label">اسم دار النشر:</label>
                <input type="text" name="houseName" class="form-control" required />
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">الدولة:</label>
                    <input type="text" name="country" class="form-control" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">المدينة:</label>
                    <input type="text" name="city" class="form-control" required />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">رقم جوال واتساب:</label>
                    <input type="text" name="whatsapp" class="form-control" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">البريد الإلكتروني (الايميل):</label>
                    <input type="email" name="email" class="form-control" required />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">اسم الشخص المسؤول:</label>
                <input type="text" name="person" class="form-control" required />
            </div>

            @if (secName == "SharjahBookFairs" || secName == "SharjahChildFestivals")
            {
                <div class="mb-3">
                    <label class="form-label">عدد الإصدارات:</label>
                    <input type="number" name="bookCount" class="form-control" value="0" />
                </div>
            }

            @if (secName == "SharjahBookFairs")
            {
                <div class="mb-3">
                    <label class="form-label">التخصص:</label>
                    <input type="text" name="specialization" class="form-control" />
                </div>
            }

            @if (secName == "SharjahBookFairs" || secName == "SharjahChildFestivals")
            {
                <div class="mb-3">
                    <label class="form-label">المساحة المطلوبة (متر مربع):</label>
                    <input type="number" step="0.01" name="requiredSpace" class="form-control" value="0" />
                </div>
            }

            <div class="d-grid gap-2 mt-4">
                <button type="submit" class="btn btn-primary btn-lg">حفظ البيانات في القاعدة</button>
                <a href="/" class="btn btn-secondary">العودة للرئيسية</a>
            </div>
        </form>
    </div>
</div>
