@{
    ViewData["Title"] = "إضافة سجل جديد";
    string secName = ViewBag.Section as string ?? "SharjahBookFairs";
    bool isWorkshop = secName == "PublishersWorkshops" || secName == "DistributorsWorkshops";
    bool isBookFair = secName == "SharjahBookFairs";
    bool isChildFestival = secName == "SharjahChildFestivals";
    bool requiresBookAndSpace = isBookFair || isChildFestival;
}

<div class="container py-5" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4 p-4">
                <h3 class="fw-bold text-dark mb-4 text-center">إضافة سجل جديد</h3>
                
                <form asp-action="AddRecord" method="post">
                    <input type="hidden" name="section" value="@secName" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">السنة</label>
                        <input type="number" name="workshopYear" class="form-control form-control-lg" value="2026" required />
                    </div>

                    @if (isWorkshop)
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold">اسم المحاضر</label>
                            <input type="text" name="lecturerName" class="form-control form-control-lg" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">الدولة</label>
                            <input type="text" name="country" class="form-control form-control-lg" required />
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold">اسم دار النشر</label>
                            <input type="text" name="publishingHouseName" class="form-control form-control-lg" required />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">الدولة</label>
                                <input type="text" name="country" class="form-control form-control-lg" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">المدينة</label>
                                <input type="text" name="city" class="form-control form-control-lg" required />
                            </div>
                        </div>

                        @if (requiresBookAndSpace)
                        {
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">عدد الكتب</label>
                                    <input type="number" name="bookCount" class="form-control form-control-lg" value="0" required />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">المساحة المطلوبة</label>
                                    <input type="text" name="requiredSpace" class="form-control form-control-lg" placeholder="مثال: 6م أو 12م" required />
                                </div>
                            </div>

                            @if (isBookFair)
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-bold">التخصص</label>
                                    <input type="text" name="specialization" class="form-control form-control-lg" placeholder="تخصص دار النشر" required />
                                </div>
                            }
                        }

                        <div class="mb-3">
                            <label class="form-label fw-bold">المسؤول</label>
                            <input type="text" name="responsiblePerson" class="form-control form-control-lg" />
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-bold">رقم الجوال (واتساب)</label>
                        <input type="text" name="whatsAppNumber" class="form-control form-control-lg" dir="ltr" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">البريد الإلكتروني</label>
                        <input type="email" name="email" class="form-control form-control-lg" dir="ltr" />
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg rounded-3 fw-bold">حفظ السجل</button>
                        <a href="/Home/Index?activeTab=@secName" class="btn btn-light btn-lg rounded-3">العودة للوحة التحكم</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>