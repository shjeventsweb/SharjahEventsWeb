@model dynamic
@{
    ViewData["Title"] = "تعديل السجل";
    string currentSection = ViewBag.Section as string ?? "";
}

<div class="container py-5" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-4 p-4 bg-white">
                <h3 class="fw-bold mb-4 text-dark text-center">✏️ تعديل السجل</h3>

                <form method="post" action="/Home/Edit">
                    <input type="hidden" name="section" value="@currentSection" />
                    <input type="hidden" name="id" value="@Model.Id" />

                    @if (currentSection == "PublishersWorkshops" || currentSection == "DistributorsWorkshops")
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold">السنة</label>
                            <input type="number" name="workshopYear" value="@Model.WorkshopYear" class="form-control rounded-3" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">اسم المحاضر</label>
                            <input type="text" name="lecturerName" value="@Model.LecturerName" class="form-control rounded-3" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">الدولة</label>
                            <input type="text" name="country" value="@Model.Country" class="form-control rounded-3" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">رقم الجوال (واتساب)</label>
                            <input type="text" name="whatsAppNumber" value="@Model.WhatsAppNumber" class="form-control rounded-3" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">البريد الإلكتروني</label>
                            <input type="email" name="email" value="@Model.Email" class="form-control rounded-3" />
                        </div>
                    }
                    else
                    {
                        string yearVal = "2026";
                        if (currentSection == "SharjahBookFairs") yearVal = Model.ExhibitionYear.ToString();
                        else if (currentSection == "SharjahChildFestivals") yearVal = Model.FestivalYear.ToString();
                        else if (currentSection == "DistributorsConferences" || currentSection == "PublishersConferences") yearVal = Model.ConferenceYear.ToString();
                        else if (currentSection == "NewYorkSessions") yearVal = Model.SessionYear.ToString();

                        <div class="mb-3">
                            <label class="form-label fw-bold">السنة</label>
                            <input type="number" name="exhibitionYear" value="@yearVal" class="form-control rounded-3" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">اسم دار النشر أو الجهة</label>
                            <input type="text" name="publishingHouseName" value="@Model.PublishingHouseName" class="form-control rounded-3" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">الدولة</label>
                            <input type="text" name="country" value="@Model.Country" class="form-control rounded-3" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">المدينة</label>
                            <input type="text" name="city" value="@Model.City" class="form-control rounded-3" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">رقم الجوال (واتساب)</label>
                            <input type="text" name="whatsAppNumber" value="@Model.WhatsAppNumber" class="form-control rounded-3" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">البريد الإلكتروني</label>
                            <input type="email" name="email" value="@Model.Email" class="form-control rounded-3" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">المسؤول</label>
                            <input type="text" name="responsiblePerson" value="@Model.ResponsiblePerson" class="form-control rounded-3" />
                        </div>
                    }

                    <div class="d-flex justify-content-between mt-4">
                        <button type="submit" class="btn btn-primary px-4 rounded-pill fw-bold">حفظ التعديلات 💾</button>
                        <a href="/Home/Index?activeTab=@currentSection" class="btn btn-secondary px-4 rounded-pill fw-bold">إلغاء ❌</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>