@{
    ViewData["Title"] = "تعديل البيانات";
    string section = ViewBag.Section as string;
}

<div class="container py-5" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-4 p-4 bg-white">
                <h3 class="fw-bold mb-4 text-primary">✏️ تعديل بيانات السجل</h3>

                <form asp-action="Edit" method="post">
                    <input type="hidden" name="section" value="@section" />
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">السنة</label>
                        <input type="number" name="@(section == "SharjahBookFairs" ? "exhibitionYear" : section == "SharjahChildFestivals" ? "festivalYear" : "conferenceYear")" 
                               value="@(section == "SharjahBookFairs" ? Model.ExhibitionYear : section == "SharjahChildFestivals" ? Model.FestivalYear : section == "DistributorsConferences" ? Model.ConferenceYear : section == "NewYorkSessions" ? Model.SessionYear : Model.ConferenceYear)" 
                               class="form-control rounded-3" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">اسم دار النشر</label>
                        <input type="text" name="publishingHouseName" value="@Model.PublishingHouseName" class="form-control rounded-3" required />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">الدولة</label>
                            <input type="text" name="country" value="@Model.Country" class="form-control rounded-3" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">المدينة</label>
                            <input type="text" name="city" value="@Model.City" class="form-control rounded-3" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">رقم الواتساب</label>
                            <input type="text" name="whatsAppNumber" value="@Model.WhatsAppNumber" class="form-control rounded-3" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">الإيميل</label>
                            <input type="email" name="email" value="@Model.Email" class="form-control rounded-3" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">المسؤول</label>
                        <input type="text" name="responsiblePerson" value="@Model.ResponsiblePerson" class="form-control rounded-3" />
                    </div>

                    @if (section == "SharjahBookFairs" || section == "SharjahChildFestivals")
                    {
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">عدد الإصدارات</label>
                                <input type="number" name="bookCount" value="@Model.BookCount" class="form-control rounded-3" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">المساحة المطلوبة (م²)</label>
                                <input type="text" name="requiredSpace" value="@Model.RequiredSpace" class="form-control rounded-3" />
                            </div>
                        </div>
                        @if (section == "SharjahBookFairs")
                        {
                            <div class="mb-3">
                                <label class="form-label fw-bold">التخصص</label>
                                <input type="text" name="specialization" value="@Model.Specialization" class="form-control rounded-3" />
                            </div>
                        }
                    }

                    <div class="d-flex justify-content-between mt-4">
                        <button type="submit" class="btn btn-primary px-4 rounded-pill fw-bold">حفظ التعديلات 💾</button>
                        <a href="/Home/Index" class="btn btn-secondary px-4 rounded-pill fw-semibold">إلغاء 🔙</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>