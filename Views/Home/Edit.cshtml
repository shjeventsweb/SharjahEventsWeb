@model dynamic
@{
    ViewData["Title"] = "تعديل السجل";
    string section = ViewBag.Section as string ?? "";
    bool isWorkshop = section == "PublishersWorkshops" || section == "DistributorsWorkshops";
}

<div class="container py-5" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4 p-4">
                <h3 class="fw-bold text-dark mb-4 text-center">تعديل بيانات السجل</h3>
                
                <form asp-action="Edit" method="post">
                    <input type="hidden" name="section" value="@section" />
                    <input type="hidden" name="id" value="@Model?.Id" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">السنة</label>
                        <input type="number" name="workshopYear" class="form-control form-control-lg" value="@(Model?.WorkshopYear ?? Model?.ExhibitionYear ?? Model?.FestivalYear ?? Model?.ConferenceYear ?? Model?.SessionYear ?? 2026)" required />
                    </div>

                    @if (isWorkshop)
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold">اسم المحاضر</label>
                            <input type="text" name="lecturerName" class="form-control form-control-lg" value="@Model?.LecturerName" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">الدولة</label>
                            <input type="text" name="country" class="form-control form-control-lg" value="@Model?.Country" required />
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold">اسم دار النشر</label>
                            <input type="text" name="publishingHouseName" class="form-control form-control-lg" value="@Model?.PublishingHouseName" required />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">الدولة</label>
                                <input type="text" name="country" class="form-control form-control-lg" value="@Model?.Country" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">المدينة</label>
                                <input type="text" name="city" class="form-control form-control-lg" value="@Model?.City" required />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">المسؤول</label>
                            <input type="text" name="responsiblePerson" class="form-control form-control-lg" value="@Model?.ResponsiblePerson" />
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-bold">رقم الجوال (واتساب)</label>
                        <input type="text" name="whatsAppNumber" class="form-control form-control-lg" value="@Model?.WhatsAppNumber" dir="ltr" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">البريد الإلكتروني</label>
                        <input type="email" name="email" class="form-control form-control-lg" value="@Model?.Email" dir="ltr" />
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-warning btn-lg rounded-3 fw-bold text-dark">تحديث البيانات</button>
                        <a href="/Home/Index?activeTab=@section" class="btn btn-light btn-lg rounded-3">إلغاء والعودة</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>